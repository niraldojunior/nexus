# V.tal Nexus — configuração da stack Docker no VPS.
# Copie para `.env.docker` (gitignored) e preencha. Ver README §"Deploy (Docker / VPS)".

# --- Infra / proxy (Caddy + compose) ---
NEXUS_DOMAIN=nexus.exemplo.com.br
LETSENCRYPT_EMAIL=voce@exemplo.com.br
# Nome da rede docker externa do contêiner Postgres já existente.
POSTGRES_NETWORK=nexus-db
# basic_auth do SPA. Gere o hash:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext '<senha>'
WEB_USER=nexus
WEB_PASSWORD_HASH=$2a$14$troque-por-hash-real

# --- Aplicação (backend) ---
NODE_ENV=production
PORT=4001
APP_NAME=v-tal-nexus
LOG_LEVEL=info

AUTH_ENABLED=true
# Token forte — o header Authorization: Bearer <AUTH_TOKEN> vale para toda rota exceto /health.
AUTH_TOKEN=troque-por-token-forte

# --- Banco (Postgres em contêiner) ---
DATABASE_PROVIDER=postgres
# Override absoluto (vence a resolução por ambiente). Sem sslmode: o contêiner não fala TLS.
DATABASE_URL=postgresql://nexus:senha@nome-do-container-pg:5432/nexus
# Espelha DATABASE_URL — os loaders de carga só leem DATABASE_URL_DEV/DATABASE_URL.
DATABASE_URL_DEV=postgresql://nexus:senha@nome-do-container-pg:5432/nexus
# Produção valida schema_migrations; o schema vem de `migrate-database`, não do boot.
DATABASE_AUTO_SCHEMA=false
DATABASE_POOL_MAX=10

# --- Integrações opcionais ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
API_ENDPOINT=https://api.openai.com/v1

# --- Build-time (Vite) — vão para dentro do bundle JS ---
VITE_GOOGLE_MAPS_API_KEY=
# Deve casar com AUTH_TOKEN: é o token que o SPA grava no localStorage no primeiro acesso.
VITE_AUTH_TOKEN=troque-por-token-forte
