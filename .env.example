# Aplicacao
NODE_ENV=development
# 4001 e a porta esperada por start-dev.ps1 (npm run dev), que faz health-check nela.
PORT=4001
APP_NAME=v-tal-nexus
LOG_LEVEL=info

# Autenticacao — todas as rotas exceto /health exigem `Authorization: Bearer <token>`.
# AUTH_TOKEN e o token estatico de maquina (scripts, MCP); usuarios reais logam com e-mail/senha
# e recebem um JWT (ver abaixo).
AUTH_ENABLED=true
AUTH_TOKEN=change-me

# Login de usuario (IdP local). Sem AUTH_JWT_SECRET o /v1/auth/login responde 503 e a SPA fica
# sem login. Emita o segredo com, p.ex., `openssl rand -hex 32`. O admin semente e criado no
# bootstrap do runtime a partir de ADMIN_EMAIL/ADMIN_PASSWORD (idempotente; so define a senha se
# a conta ainda nao tiver uma). AUTH_ACCESS_TOKEN_TTL_HORAS controla a validade do token (default 12).
AUTH_JWT_SECRET=
ADMIN_EMAIL=admin@vtal.com.br
ADMIN_PASSWORD=
AUTH_ACCESS_TOKEN_TTL_HOURS=12

# Banco (Neon Postgres) — use sempre o endpoint `-pooler`.
# Ordem de resolucao: DATABASE_URL > (por ambiente) PROD / DEV / TEST. Ver src/shared/config/env.ts
DATABASE_PROVIDER=postgres
DATABASE_URL_DEV=postgresql://<neon-dev-user>:<password>@<neon-dev-host>-pooler/<database>?sslmode=require
DATABASE_URL_TEST=postgresql://<neon-test-user>:<password>@<neon-test-host>-pooler/<database>?sslmode=require
DATABASE_URL_PROD=postgresql://<neon-prod-user>:<password>@<neon-prod-host>-pooler/<database>?sslmode=require

# Oracle 21c/23ai em Thin mode; obrigatorias quando DATABASE_PROVIDER=oracle.
ORACLE_CONNECTION_STRING=<host>:1521/<service-name>
ORACLE_USER=nexus_runtime
ORACLE_PASSWORD=
# Prefixo de objetos: a instancia corporativa hospeda DEV/HML/PRD num unico schema, distinguidos
# pelo prefixo de cada objeto. Deve terminar em `_`. Ex.: NEXUS_DEV_ / NEXUS_HML_ / NEXUS_PRD_.
# A suite de teste usa NEXUS_TEST_.
ORACLE_OBJECT_PREFIX=NEXUS_DEV_
# Pool Oracle (segundos). ORACLE_POOL_* sobrepoe os defaults compartilhados DATABASE_POOL_*.
ORACLE_POOL_MIN=1
ORACLE_POOL_MAX=5
ORACLE_POOL_TIMEOUT_SECONDS=30
ORACLE_POOL_PING_INTERVAL_SECONDS=30

# Pool Postgres.
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_POOL_INCREMENT=1
DATABASE_QUEUE_TIMEOUT_MS=2000
DATABASE_CONNECTION_TIMEOUT_MS=15000
# Somente development/test; producao valida schema_migrations e falha se desatualizado.
DATABASE_AUTO_SCHEMA=false

# Carga PostgreSQL -> Oracle.
SOURCE_DATABASE_URL=
TARGET_ORACLE_CONNECT_STRING=
TARGET_ORACLE_USER=
TARGET_ORACLE_PASSWORD=
# Prefixo dos objetos de destino; deve casar com o ORACLE_OBJECT_PREFIX do runtime de destino.
TARGET_ORACLE_OBJECT_PREFIX=NEXUS_PRD_
MIGRATION_BATCH_SIZE=1000

# Integracoes opcionais
# Sem OPENAI_API_KEY, o Copilot cai em fallback local sobre docs/
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
API_ENDPOINT=https://api.openai.com/v1
VITE_GOOGLE_MAPS_API_KEY=
